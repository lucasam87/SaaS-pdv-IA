rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Arquivos de importação (PDFs e planilhas Excel)
    match /tenants/{tenantId}/imports/{fileName} {
      allow read, write: if request.auth != null && 
        (request.auth.token.tenantId == tenantId || request.auth.uid == tenantId);
    }
  }
}
